# Copy to .env and fill in. Never commit .env.

# RPC endpoint — use devnet while testing:
# https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Base58-encoded secret key of the deployer wallet.
# Use a DEDICATED deployer wallet, never your main wallet.
WALLET_SECRET_KEY=

# Filled in after running the scripts
COLLECTION_MINT=
CANDY_MACHINE_ID=

# Collection details
COLLECTION_NAME=My Collection
COLLECTION_SYMBOL=MYC
COLLECTION_DESCRIPTION=A professional NFT collection deployed to Solana.

# Mint settings
MINT_PRICE_SOL=0.1
MINT_START_DATE=2026-10-01T00:00:00Z
